    given-names: "Kushal"
  - family-names: "KN"
    given-names: "Kushaal"
repository-code: "https://github.com/YKushal-hub/ca-tbl-localization"
license: GPL-2.0-only
keywords:
  - localization
  - search and rescue
  - LoRa
  - ultra-wideband
  - ns-3
  - Kalman filter
