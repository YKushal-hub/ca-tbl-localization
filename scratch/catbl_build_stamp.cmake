# M.3 (TECH_DEBT): the commit a binary was BUILT from, stamped at build time.
#
# Run by the catbl_build_stamp target before every build of scratch_ca_tbl_causal_sim:
#   cmake -DSRC=<source root> -DOUT=<generated .cc> -P catbl_build_stamp.cmake
# It records what run_id.txt's 'source' line records, by the same rule -- the short HEAD,
# and tracked modifications under src/ and scratch/ -- but of the tree that compiled the
# binary, not of the directory a run is launched from. The file is rewritten only when its
# contents change, so an unchanged tree recompiles nothing.
execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git status --porcelain --untracked-files=no -- src scratch
                WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE st ERROR_QUIET RESULT_VARIABLE strc)
if(head STREQUAL "" OR NOT strc EQUAL 0)
  set(head "unknown")
  set(dirty "-1")
else()
  string(REGEX MATCHALL "\n" nl "${st}")
  list(LENGTH nl dirty)
endif()
set(body "// Generated by scratch/catbl_build_stamp.cmake at build time. Do not edit.\nextern const char* const kCatblBuildCommit;\nextern const int kCatblBuildDirty;\nconst char* const kCatblBuildCommit = \"${head}\";\nconst int kCatblBuildDirty = ${dirty};\n")
set(old "")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL body)
  file(WRITE ${OUT} "${body}")
endif()
